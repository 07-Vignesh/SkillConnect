router.post("/", async (req, res) => {
  const { clerkId, name, email, city, pincode, category, price, services } = req.body;

  try {
    // Check if freelancer already exists
    let freelancer = await Freelancer.findOne({ clerkId });
    if (freelancer) {
      return res.status(400).json({ message: "Freelancer profile already exists." });
    }

    freelancer = new Freelancer({
      clerkId,
      name,
      email,
      city,
      pincode,
      category,
      price,
      services,
    });

    await freelancer.save();

    res.status(201).json(freelancer);
  } catch (error) {
    console.error("Error creating freelancer profile:", error);
    res.status(500).json({ message: "Server error" });
  }
});
